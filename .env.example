# Server
PORT=3000

# MoySklad API token. Create it in MoySklad and keep it only on the server.
MOYSKLAD_TOKEN=put_your_token_here

# Which MoySklad document to create:
# auto = Полная оплата в Продажу, рассрочка/смешанная оплата в Отгрузку
# retaildemand = Продажа в рознице
# demand = Отгрузка
# customerorder = Заказ покупателя
MOYSKLAD_DOCUMENT_TYPE=auto

# Required MoySklad entity hrefs.
# Open the entity through JSON API or copy hrefs from API responses.
MOYSKLAD_ORGANIZATION_HREF=https://api.moysklad.ru/api/remap/1.2/entity/organization/00000000-0000-0000-0000-000000000000
MOYSKLAD_AGENT_HREF=https://api.moysklad.ru/api/remap/1.2/entity/counterparty/00000000-0000-0000-0000-000000000000

# Required for Отгрузка. For retaildemand it can be taken from the selected retail store.
MOYSKLAD_STORE_HREF=https://api.moysklad.ru/api/remap/1.2/entity/store/00000000-0000-0000-0000-000000000000

# Optional fallback point of sale for retaildemand. Usually the app loads retail stores from MoySklad.
MOYSKLAD_RETAIL_STORE_HREF=https://api.moysklad.ru/api/remap/1.2/entity/retailstore/00000000-0000-0000-0000-000000000000

# Assortment item that will be added to the order/demand.
# Can be a product, service, bundle, variant, etc. The app sends the final installment price here.
MOYSKLAD_ASSORTMENT_HREF=https://api.moysklad.ru/api/remap/1.2/entity/product/00000000-0000-0000-0000-000000000000
MOYSKLAD_ASSORTMENT_TYPE=product
MOYSKLAD_PRODUCT_PRICE_NAME=Цена 6м

# Optional status href, for example the status "Новый" or your installment status.
MOYSKLAD_STATE_HREF=

# Demand custom attributes and custom entity ids.
MOYSKLAD_PAYMENT_TYPE_ATTRIBUTE_HREF=https://api.moysklad.ru/api/remap/1.2/entity/demand/metadata/attributes/00000000-0000-0000-0000-000000000000
MOYSKLAD_PAYMENT_TYPE_CUSTOM_ENTITY_ID=00000000-0000-0000-0000-000000000000
MOYSKLAD_RECEIVABLE_ATTRIBUTE_HREF=https://api.moysklad.ru/api/remap/1.2/entity/demand/metadata/attributes/00000000-0000-0000-0000-000000000000
MOYSKLAD_PAID_ATTRIBUTE_HREF=https://api.moysklad.ru/api/remap/1.2/entity/demand/metadata/attributes/00000000-0000-0000-0000-000000000000
MOYSKLAD_UNPAID_ATTRIBUTE_HREF=https://api.moysklad.ru/api/remap/1.2/entity/demand/metadata/attributes/00000000-0000-0000-0000-000000000000
MOYSKLAD_EMPLOYEE_ATTRIBUTE_HREF=https://api.moysklad.ru/api/remap/1.2/entity/demand/metadata/attributes/00000000-0000-0000-0000-000000000000
MOYSKLAD_NET_PROFIT_ATTRIBUTE_HREF=
MOYSKLAD_EMPLOYEE_CUSTOM_ENTITY_ID=00000000-0000-0000-0000-000000000000

# Retaildemand custom attributes, if you create them in "Продажа" metadata.
MOYSKLAD_RETAILDEMAND_PAYMENT_TYPE_ATTRIBUTE_HREF=
MOYSKLAD_RETAILDEMAND_RECEIVABLE_ATTRIBUTE_HREF=
MOYSKLAD_RETAILDEMAND_EMPLOYEE_ATTRIBUTE_HREF=
MOYSKLAD_RETAILDEMAND_COMMISSION_ATTRIBUTE_HREF=
MOYSKLAD_RETAILDEMAND_NET_PROFIT_ATTRIBUTE_HREF=

# Customerorder custom attributes, if you create them in "Заказ покупателя" metadata.
MOYSKLAD_CUSTOMERORDER_PAYMENT_TYPE_ATTRIBUTE_HREF=
MOYSKLAD_CUSTOMERORDER_RECEIVABLE_ATTRIBUTE_HREF=
MOYSKLAD_CUSTOMERORDER_EMPLOYEE_ATTRIBUTE_HREF=
MOYSKLAD_CUSTOMERORDER_COMMISSION_ATTRIBUTE_HREF=
MOYSKLAD_CUSTOMERORDER_NET_PROFIT_ATTRIBUTE_HREF=

# Closed owner reports page: /report.html
REPORT_LOGIN=btech
REPORT_PASSWORD=03051609
REPORT_SESSION_SECRET=change-this-long-random-secret

# Loyalty bonuses. Set LOYALTY_ENABLED=false to hide the feature and keep the old workflow.
LOYALTY_ENABLED=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=put_your_service_role_key_here
LOYALTY_ACCRUAL_PERCENT=3
LOYALTY_MAX_REDEEM_PERCENT=30
