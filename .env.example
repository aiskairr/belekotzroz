# Server
PORT=3000

# MoySklad API token. Create it in MoySklad and keep it only on the server.
MOYSKLAD_TOKEN=put_your_token_here

# Which MoySklad document to create:
# customerorder = Заказ покупателя
# demand = Отгрузка
MOYSKLAD_DOCUMENT_TYPE=customerorder

# Required MoySklad entity hrefs.
# Open the entity through JSON API or copy hrefs from API responses.
MOYSKLAD_ORGANIZATION_HREF=https://api.moysklad.ru/api/remap/1.2/entity/organization/00000000-0000-0000-0000-000000000000
MOYSKLAD_AGENT_HREF=https://api.moysklad.ru/api/remap/1.2/entity/counterparty/00000000-0000-0000-0000-000000000000

# Required for Отгрузка, optional for Заказ покупателя.
MOYSKLAD_STORE_HREF=https://api.moysklad.ru/api/remap/1.2/entity/store/00000000-0000-0000-0000-000000000000

# Assortment item that will be added to the order/demand.
# Can be a product, service, bundle, variant, etc. The app sends the final installment price here.
MOYSKLAD_ASSORTMENT_HREF=https://api.moysklad.ru/api/remap/1.2/entity/product/00000000-0000-0000-0000-000000000000
MOYSKLAD_ASSORTMENT_TYPE=product

# Optional status href, for example the status "Новый" or your installment status.
MOYSKLAD_STATE_HREF=

# Demand custom attribute "Тип оплаты" and its custom entity id.
MOYSKLAD_PAYMENT_TYPE_ATTRIBUTE_HREF=https://api.moysklad.ru/api/remap/1.2/entity/demand/metadata/attributes/00000000-0000-0000-0000-000000000000
MOYSKLAD_PAYMENT_TYPE_CUSTOM_ENTITY_ID=00000000-0000-0000-0000-000000000000
MOYSKLAD_RECEIVABLE_ATTRIBUTE_HREF=https://api.moysklad.ru/api/remap/1.2/entity/demand/metadata/attributes/00000000-0000-0000-0000-000000000000
MOYSKLAD_EMPLOYEE_ATTRIBUTE_HREF=https://api.moysklad.ru/api/remap/1.2/entity/demand/metadata/attributes/00000000-0000-0000-0000-000000000000
MOYSKLAD_EMPLOYEE_CUSTOM_ENTITY_ID=00000000-0000-0000-0000-000000000000
