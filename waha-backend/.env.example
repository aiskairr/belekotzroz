PORT=3300

# WAHA server. If your CRM uses :3000, run WAHA on another port, for example :3001.
WAHA_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=default
CORS_ORIGIN=http://localhost:3000

# Protect this backend API. Leave empty only for local tests.
BACKEND_API_KEY=change-me

# Auto-reply product bot
BOT_ENABLED=false
BOT_API_URL=http://127.0.0.1:3000/api/bot/products
BOT_API_KEY=change-me
BOT_REPLY_DELAY_MS=1800
BOT_COOLDOWN_MS=8000

# Sending defaults
SEND_DELAY_MS=30000
SEND_MIN_DELAY_MS=25000
SEND_MAX_DELAY_MS=45000
MAX_BATCH_SIZE=200
